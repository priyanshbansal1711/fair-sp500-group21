@prefix dct: <http://purl.org/dc/terms/> .
@prefix ont: <https://w3id.org/FAIR-course-UT/2026/group21/ont#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix schema: <https://schema.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/FAIR-course-UT/2026/group21/ont> a owl:Ontology ;
    dct:creator "Priyansh Bansal" ;
    dct:description "Classes and properties used to represent S&P 500 constituent companies, their GICS classification and a dated snapshot of their market and financial indicators."@en ;
    dct:issued "2026-10-24"^^xsd:date ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:title "S&P 500 company financials ontology (group 21)"@en ;
    rdfs:seeAlso <http://www.w3.org/2004/02/skos/core>,
        schema:Corporation ;
    owl:versionInfo "1.0" .

ont:dividendYield a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "dividend yield"@en ;
    rdfs:comment "Annual dividend per share divided by share price, expressed as a decimal fraction (0.02 = 2 %)."@en ;
    rdfs:domain ont:FinancialSnapshot ;
    rdfs:range xsd:decimal .

ont:earningsPerShare a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "earnings per share"@en ;
    rdfs:comment "Trailing twelve-month earnings per share in USD; can be negative."@en ;
    rdfs:domain ont:FinancialSnapshot ;
    rdfs:range xsd:decimal .

ont:ebitda a owl:DatatypeProperty,
        owl:FunctionalProperty ;
    rdfs:label "EBITDA"@en ;
    rdfs:comment "Earnings before interest, taxes, depreciation and amortisation (trailing twelve months) in USD."@en ;
    rdfs:domain ont:FinancialSnapshot ;
    rdfs:range xsd:decimal .

