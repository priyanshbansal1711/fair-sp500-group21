ont:GICSSubIndustry a owl:Class ;
    rdfs:label "GICS sub-industry"@en ;
    rdfs:comment "Most detailed level of GICS (8-digit code), e.g. 20105010 Industrial Conglomerates."@en ;
    rdfs:subClassOf ont:GICSClassificationLevel .

ont:GICS a skos:ConceptScheme ;
    rdfs:label "Global Industry Classification Standard (2023 structure)"@en ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Global_Industry_Classification_Standard> ;
