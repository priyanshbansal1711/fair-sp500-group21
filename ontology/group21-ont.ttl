ont:GICSSector a owl:Class ;
    rdfs:label "GICS sector"@en ;
    rdfs:comment "Top level of GICS (2-digit code), e.g. 20 Industrials."@en ;
    rdfs:subClassOf ont:GICSClassificationLevel .

ont:GICSIndustryGroup a owl:Class ;
    rdfs:label "GICS industry group"@en ;
