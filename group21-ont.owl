  <rdf:Description rdf:about="https://w3id.org/FAIR-course-UT/2025-2026/group21/ont">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <dct:title xml:lang="en">S&amp;P 500 company financials ontology (group 21)</dct:title>
    <dct:description xml:lang="en">Classes and properties used to represent S&amp;P 500 constituent companies, their GICS classification and a dated snapshot of their market and financial indicators.</dct:description>
