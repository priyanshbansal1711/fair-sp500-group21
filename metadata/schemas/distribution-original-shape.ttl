@prefix :     <https://w3id.org/FAIR-course-UT/2026/group21/shapes/distribution-original#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Metadata schema 2 of 3 - DISTRIBUTION of the ORIGINAL dataset (CSV as found).
# Applied to the distributions linked from a dataset (see :DatasetShape).

:OriginalDistributionShape
    a sh:NodeShape ;
    sh:property
        [ sh:path dct:title ;        sh:name "title" ;
          sh:nodeKind sh:Literal ; sh:minCount 1 ; sh:maxCount 1 ;
          dash:editor dash:TextFieldEditor ; dash:viewer dash:LiteralViewer ; sh:order 1 ] ,
        [ sh:path dct:description ;  sh:name "description" ;
          sh:nodeKind sh:Literal ; sh:maxCount 1 ;
          dash:editor dash:TextAreaEditor ; dash:viewer dash:LiteralViewer ; sh:order 2 ] ,
        [ sh:path dcat:mediaType ;   sh:name "media type" ;
          sh:hasValue <https://www.iana.org/assignments/media-types/text/csv> ; sh:maxCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 3 ] ,
        [ sh:path dcat:downloadURL ; sh:name "download URL (w3id of our copy of the original file)" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          sh:pattern "^https://w3id.org/FAIR-course-UT/2026/group21/" ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 4 ] ,
        [ sh:path dct:source ;       sh:name "source (URL the original file was downloaded from)" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 5 ] ,
        [ sh:path dcat:accessURL ;   sh:name "access URL (page where the file is offered)" ;
          sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 6 ] ,
        [ sh:path dct:license ;      sh:name "license" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 7 ] ,
        [ sh:path dct:issued ;       sh:name "date retrieved" ;
          sh:datatype xsd:date ; sh:maxCount 1 ;
          dash:editor dash:DatePickerEditor ; dash:viewer dash:LiteralViewer ; sh:order 8 ] ,
        [ sh:path dcat:byteSize ;    sh:name "size in bytes" ;
          sh:datatype xsd:nonNegativeInteger ; sh:maxCount 1 ;
          dash:editor dash:TextFieldEditor ; dash:viewer dash:LiteralViewer ; sh:order 9 ] .
