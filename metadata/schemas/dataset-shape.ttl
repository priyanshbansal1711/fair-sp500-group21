@prefix :     <https://w3id.org/FAIR-course-UT/2026/group21/shapes/dataset#> .
@prefix dorig: <https://w3id.org/FAIR-course-UT/2026/group21/shapes/distribution-original#> .
@prefix drdf: <https://w3id.org/FAIR-course-UT/2026/group21/shapes/distribution-rdf#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix dash: <http://datashapes.org/dash#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dct:  <http://purl.org/dc/terms/> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# Metadata schema 1 of 3 - the DATASET (serialisation-independent description).
# Every property is reused from W3C DCAT 2, Dublin Core Terms or PROV-O.
# The two distribution shapes are defined in distribution-original-shape.ttl and
# distribution-rdf-shape.ttl; load all three files together when validating.

:DatasetShape
    a sh:NodeShape ;
    sh:targetClass dcat:Dataset ;
    sh:property
        [ sh:path dct:title ;          sh:name "title" ;
          sh:nodeKind sh:Literal ; sh:minCount 1 ; sh:maxCount 1 ; sh:maxLength 120 ;
          dash:editor dash:TextFieldEditor ; dash:viewer dash:LiteralViewer ; sh:order 1 ] ,
        [ sh:path dct:description ;    sh:name "description" ;
          sh:nodeKind sh:Literal ; sh:minCount 1 ; sh:maxCount 1 ; sh:maxLength 1000 ;
          dash:editor dash:TextAreaEditor ; dash:viewer dash:LiteralViewer ; sh:order 2 ] ,
        [ sh:path dct:creator ;        sh:name "creator (original creator of the data)" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 3 ] ,
        [ sh:path dct:publisher ;      sh:name "publisher" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 4 ] ,
        [ sh:path dct:license ;        sh:name "license" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ; sh:maxCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 5 ] ,
        [ sh:path dcat:keyword ;       sh:name "keyword" ;
          sh:nodeKind sh:Literal ; sh:minCount 1 ;
          dash:editor dash:TextFieldEditor ; dash:viewer dash:LiteralViewer ; sh:order 6 ] ,
        [ sh:path dcat:theme ;         sh:name "theme" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 7 ] ,
        [ sh:path dct:issued ;         sh:name "issued" ;
          sh:datatype xsd:date ; sh:maxCount 1 ;
          dash:editor dash:DatePickerEditor ; dash:viewer dash:LiteralViewer ; sh:order 8 ] ,
        [ sh:path dct:temporal ;       sh:name "temporal coverage (snapshot date)" ;
          sh:node :PeriodOfTimeShape ; sh:maxCount 1 ;
          dash:viewer dash:DetailsViewer ; sh:order 9 ] ,
        [ sh:path dct:language ;       sh:name "language" ;
          sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 10 ] ,
        [ sh:path dct:source ;         sh:name "source (where the data originally comes from)" ;
          sh:nodeKind sh:IRI ; sh:minCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 11 ] ,
        [ sh:path dcat:landingPage ;   sh:name "landing page" ;
          sh:nodeKind sh:IRI ; sh:maxCount 1 ;
          dash:editor dash:URIEditor ; dash:viewer dash:LabelViewer ; sh:order 12 ] ,
        [ sh:path dct:hasVersion ;     sh:name "version" ;
          sh:nodeKind sh:Literal ; sh:maxCount 1 ;
          dash:editor dash:TextFieldEditor ; dash:viewer dash:LiteralViewer ; sh:order 13 ] ,
        # The dataset must be available both as the original file and as RDF.
        [ sh:path dcat:distribution ;  sh:name "distribution" ;
          sh:nodeKind sh:IRI ; sh:minCount 2 ;
          sh:qualifiedValueShape dorig:OriginalDistributionShape ; sh:qualifiedMinCount 1 ;
          dash:viewer dash:LabelViewer ; sh:order 14 ] ,
        [ sh:path dcat:distribution ;
          sh:qualifiedValueShape drdf:RDFDistributionShape ; sh:qualifiedMinCount 1 ] .

:PeriodOfTimeShape
    a sh:NodeShape ;
    sh:property
        [ sh:path dcat:startDate ; sh:datatype xsd:date ; sh:minCount 1 ; sh:maxCount 1 ] ,
        [ sh:path dcat:endDate ;   sh:datatype xsd:date ; sh:maxCount 1 ] .
